}

QLabel#CardDetailField {
    background-color: transparent;
    color: #aeb5c2;
    font-size: 13px;
    padding: 2px 0;
}

QLabel#CardDetailOracle {
    background-color: transparent;
    color: #e0e3ea;
    font-size: 14px;
    line-height: 1.45;
}

QLabel#CardDetailFlavor {
    background-color: transparent;
    color: #8b93a3;
    font-size: 13px;
    font-style: italic;
}

QLabel#CardDetailMuted {
    background-color: transparent;
    color: #737c8d;
    font-size: 13px;
}

QPushButton#CardDetailMutedButton {
    background-color: #161a23;
    color: #b6bdcb;
    border: 1px solid #2a3040;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#CardDetailMutedButton:hover {
    background-color: #1a1f2a;
    border: 1px solid #d4a84b;
    color: #e4c36b;
}

QPushButton#CardDetailMutedButton:pressed {
    background-color: #202632;
}

QFrame#CardDetailSeparator {
    background-color: #2c3342;
    border: none;
    max-height: 1px;
    margin: 8px 0;
}

QLabel#CardDetailSet {
    background-color: transparent;
    color: #6b7486;
    font-size: 13px;
}

QLabel#CardDetailQuantity {
    background-color: transparent;
    color: #ffffff;
    font-size: 14px;
    font-weight: 700;
}

QLabel#CardDetailText {
    background-color: #161a23;
    border: 1px solid #2a3040;
    border-radius: 8px;
    color: #cdd2dd;
    padding: 12px;
    font-size: 13px;
}

QWidget#CardDetailLeftPanel,
QWidget#CardDetailRightPanel {
    background-color: transparent;
    border: none;
}

QWidget#FaceSwitch {
    background-color: #161a23;
    border: 1px solid #2a3040;
    border-radius: 10px;
}

QPushButton#FaceSwitchButton {
    background-color: transparent;
    color: #8b93a3;
    border: none;
    border-radius: 7px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton#FaceSwitchButton:hover {
    background-color: #1e2330;
    color: #ffffff;
}

QPushButton#FaceSwitchButton:checked {
    background-color: #d4a84b;
    color: #14161d;
}

QComboBox#DetailSelector {
    background-color: #161a23;
    border: 1px solid #2a3040;
    border-radius: 9px;
    color: #e0e3ea;
    padding: 9px 12px;
}

QWidget#CardDetailMana,
QWidget#CardDetailMana QLabel,
QWidget#CardDetailMana QWidget {
    background-color: transparent;
    border: none;
}

QFrame#DetailInfoCard {
    background-color: #161a23;
    border: 1px solid #2a3040;
    border-radius: 8px;
}

QFrame#DetailInfoCard:hover {
    border: 1px solid #3d4557;
    background-color: #1a1f2a;
}

QLabel#DetailInfoTitle {
    background-color: transparent;
    color: #6b7486;
    font-size: 11px;
    font-weight: 700;
}

QLabel#DetailInfoValue {
    background-color: transparent;
    color: #eef0f5;
    font-size: 13px;
}

QLabel#DetailPriceTitle {
    background-color: transparent;
    color: #6b7486;
    font-size: 11px;
    font-weight: 700;
}

QLabel#DetailPriceValue {
    background-color: transparent;
    color: #eef0f5;
    font-size: 13px;
}

QLabel#DetailMarketValue {
    background-color: transparent;
    color: #cdd2dd;
    font-size: 16px;
    font-weight: 600;
}

QFrame#MarketValueCard {
    background-color: #161a23;
    border: 1px solid #2a3040;
    border-radius: 9px;
}

QFrame#MarketValueCard:hover {
    background-color: #1a1f2a;
    border: 1px solid #3d4557;
}

QLabel#DetailMarketTotal {
    background-color: transparent;
    color: #d4a84b;
    font-size: 22px;
    font-weight: 800;
}

QTabWidget#CardDetailTabs::pane {
    background-color: transparent;
    border: none;
    padding-top: 10px;
}

QTabWidget#CardDetailTabs QTabBar::tab {
    background-color: #161a23;
    color: #8b93a3;
    border: 1px solid #2a3040;
    border-radius: 7px;
    padding: 8px 14px;
    margin-right: 6px;
}

QTabWidget#CardDetailTabs QTabBar::tab:selected {
    background-color: #292f3d;
    color: #ffffff;
    border-color: #3d4557;
}

/* =========================================================
   SÍMBOLOS DE MANA
========================================================= */

QLabel#ManaSymbol {
    background-color: transparent;
    border: none;
}

QLabel#CardManaEmpty {
    background-color: transparent;
    color: #5c6474;
    font-size: 12px;
}

QLabel#CardManaLoading,
QLabel#CardManaFallback {
    background-color: transparent;
    color: #8b93a3;
    font-size: 12px;
}

/* =========================================================
   AUTOCOMPLETE
========================================================= */

QListWidget#SuggestionList {
    background-color: #1a1e29;
    color: #e8ebf2;
    border: 1px solid #2f3646;
    border-radius: 8px;
    padding: 4px;
    outline: none;
}

QListWidget#SuggestionList::item {
    background-color: transparent;
    padding: 9px 12px;
    border-radius: 6px;
}

QListWidget#SuggestionList::item:hover {
    background-color: #1e2330;
}

QListWidget#SuggestionList::item:selected {
    background-color: #292f3d;
    color: #ffffff;
}

/* =========================================================
   TABELAS
========================================================= */

QTableWidget,
QTableView {
    background-color: #161a23;
    alternate-background-color: #181c26;
    color: #e0e3ea;
    border: 1px solid #2a3040;
    border-radius: 9px;
    gridline-color: #2a3040;
    outline: none;
}

QTableWidget::item,
QTableView::item {
    padding: 7px;
    border: none;
}

QTableWidget::item:hover,
QTableView::item:hover {
    background-color: #1e2330;
}

QTableWidget::item:selected,
QTableView::item:selected {
    background-color: #292f3d;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #1a1e29;
    color: #aeb5c2;
    border: none;
    border-bottom: 1px solid #2c3342;
    padding: 9px 10px;
    font-weight: 600;
}

QHeaderView::section:hover {
    background-color: #232936;
    color: #ffffff;
}

/* =========================================================
   LISTAS GERAIS
========================================================= */

QListWidget,
QListView {
    background-color: #161a23;
    color: #e0e3ea;
    border: 1px solid #2a3040;
    border-radius: 9px;
    outline: none;
    padding: 4px;
}

QListWidget::item,
QListView::item {
    padding: 8px 10px;
    border-radius: 6px;
}

QListWidget::item:hover,
QListView::item:hover {
    background-color: #1e2330;
}

QListWidget::item:selected,
QListView::item:selected {
    background-color: #292f3d;
    color: #ffffff;
}

/* =========================================================
   STATUS BAR / TOOLBAR / DIVERSOS
========================================================= */

QStatusBar {
    background-color: #151821;
    color: #737c8d;
    border-top: 1px solid #232936;
}

QStatusBar::item {
    border: none;
}

QToolBar {
    background-color: #151821;
    border: none;
    spacing: 5px;
    padding: 4px;
}

QToolBar::separator {
    background-color: #2c3342;
    width: 1px;
    margin: 5px 4px;
}

QToolTip {
    background-color: #1a1e29;
    color: #e8ebf2;
    border: 1px solid #2f3646;
    border-radius: 6px;
    padding: 6px 9px;
}

QToolButton {
    background-color: transparent;
    color: #9aa2b1;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 7px 9px;
}

QToolButton:hover {
    background-color: #1e2330;
    border: 1px solid #2f3646;
    color: #ffffff;
}

QToolButton:checked {
    background-color: #292f3d;
    border: 1px solid #3a4253;
    color: #ffffff;
}

QToolButton:disabled {
    background-color: transparent;
    color: #4a5160;
}

QProgressBar {
    background-color: #161a23;
    color: #e0e3ea;
    border: 1px solid #2a3040;
    border-radius: 7px;
    text-align: center;
    min-height: 14px;
}

QProgressBar::chunk {
    background-color: #d4a84b;
    border-radius: 5px;
}

QGroupBox {
    background-color: #161a23;
    color: #d6dae3;
    border: 1px solid #2a3040;
    border-radius: 9px;
    margin-top: 12px;
    padding: 12px;
}

QGroupBox::title {
    background-color: #161a23;
    color: #aeb5c2;
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
}

QCheckBox {
    background-color: transparent;
    color: #d6dae3;
    spacing: 8px;
}

QCheckBox:hover {
    color: #ffffff;
}

QCheckBox::indicator {
    width: 17px;
    height: 17px;
    background-color: #161a23;
    border: 1px solid #2f3646;
    border-radius: 5px;
}

QCheckBox::indicator:hover {
    background-color: #1e2330;
    border: 1px solid #3d4557;
}

QCheckBox::indicator:checked {
    background-color: #d4a84b;
    border: 1px solid #d4a84b;
}

QRadioButton {
    background-color: transparent;
    color: #d6dae3;
    spacing: 8px;
}

QRadioButton::indicator {
    width: 17px;
    height: 17px;
    background-color: #161a23;
    border: 1px solid #2f3646;
    border-radius: 9px;
}

QRadioButton::indicator:checked {
    background-color: #d4a84b;
    border: 4px solid #161a23;
}

QSpinBox,
QDoubleSpinBox {
    background-color: #161a23;
    color: #ffffff;
    border: 1px solid #2a3040;
    border-radius: 8px;
    padding: 8px 10px;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    background-color: #1e2330;
    border: none;
    width: 22px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: #2c3444;
}

QSlider::groove:horizontal {
    height: 5px;
    background-color: #2a3040;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -5px 0;
    background-color: #d4a84b;
    border: 1px solid #e6c77b;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background-color: #e6c77b;
}

QSlider::sub-page:horizontal {
    background-color: #d4a84b;
    border-radius: 3px;
}

QTabWidget::pane {
    background-color: #161a23;
    border: 1px solid #2a3040;
    border-radius: 8px;
}

QTabBar::tab {
    background-color: #181c26;
    color: #737c8d;
    border: 1px solid #2a3040;
    padding: 8px 14px;
    margin-right: 2px;
}

QTabBar::tab:hover {
    background-color: #1e2330;
    color: #d6dae3;
}

QTabBar::tab:selected {
    background-color: #292f3d;
    color: #ffffff;
    border-color: #3d4557;
}

QFrame {
    background-color: transparent;
}

QLabel:disabled {
    color: #4a5160;
}

