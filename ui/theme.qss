    background-color: #1c1e22;
    border: 1px solid #383b41;
    color: #ffffff;
}

/* DESABILITADO */

QPushButton#GridQuantityButton:disabled {
    background-color: #181c25;
    border: 1px solid #232936;
    color: #4a5160;
}

