    background-color: rgba(10, 12, 17, 235);

    border: 1px solid #303339;
    border-radius: 10px;
}

QLabel#GridQuantityLabel {
    background-color: transparent;
    color: #ffffff;
    border: none;
    font-size: 14px;
    font-weight: 700;
    padding: 2px 7px;
}

/* =========================================================
   CONTROLES DE QUANTIDADE — COLLECTION
========================================================= */

QFrame#GridQuantityOverlay {
    background-color: rgba(13, 14, 16, 235);
    border: 1px solid #303339;
    border-radius: 10px;
}

/* ---------------------------------------------------------
   BOTÕES + / -
--------------------------------------------------------- */

QPushButton#GridQuantityButton {
    background-color: #232936;
    color: #d6dae3;

    border: 1px solid #2f3646;
    border-radius: 6px;

    min-width: 30px;
    max-width: 30px;

    min-height: 30px;
    max-height: 30px;

    padding: 0;

    font-size: 16px;
    font-weight: 700;
}

QPushButton#GridQuantityButton:hover {
    background-color: #303339;
    border: 1px solid #454850;
    color: #ffffff;
}

/* PRESSIONADO */

