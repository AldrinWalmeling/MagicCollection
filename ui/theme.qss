/* =========================================================
   MAGIC COLLECTION — TEMA ESCURO (OURO)
   bg #0f1117 · painéis #1a1d27 · ouro #d4a84b
========================================================= */

* {
    font-family: "Segoe UI";
    outline: none;
}

QMainWindow,
QWidget {
    background-color: #0f1117;
    color: #f2f4f8;
    font-size: 14px;
}

QWidget#ContentWidget {
    background-color: #0f1117;
}

/* =========================================================
   SIDEBAR
========================================================= */

QFrame#Sidebar {
    background-color: #151821;
    border-right: 1px solid #232936;
}

QWidget#AppHeader {
    background-color: transparent;
    border: none;
}

QLabel#AppIcon {
    background-color: #1f2330;
    border: 1px solid #2d3442;
    border-radius: 10px;
    padding: 4px;
}

QLabel#AppTitle {
    background-color: transparent;
    color: #ffffff;
    font-size: 18px;
    font-weight: 700;
}

QLabel#SidebarSectionLabel {
    background-color: transparent;
    color: #5c6474;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    padding: 14px 10px 4px 10px;
}

QFrame#SidebarDivider {
    background-color: #232936;
    border: none;
    max-height: 1px;
    margin: 6px 10px;
}

QPushButton#SidebarButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 9px;
    color: #a6adbd;
    font-size: 14px;
    font-weight: 600;
    text-align: left;
    padding: 9px 14px;
    margin: 1px 6px;
    min-height: 40px;
    max-height: 40px;
}

QPushButton#SidebarButton:hover {
    background-color: #1e2330;
    color: #e8ebf2;
}

QPushButton#SidebarButton:checked {
    background-color: #292f3d;
    color: #ffffff;
    border: 1px solid #3a4253;
    font-weight: 700;
}

QPushButton#SidebarButton:pressed {
    background-color: #232936;
}

QFrame#SidebarProfile {
    background-color: #1a1e29;
    border: 1px solid #2a3040;
    border-radius: 12px;
}

QLabel#SidebarAvatar {
    background-color: #d4a84b;
    color: #14161d;
    border-radius: 18px;
    font-size: 17px;
    font-weight: 800;
}

QLabel#SidebarProfileName {
    background-color: transparent;
    color: #f2f4f8;
    font-size: 14px;
    font-weight: 700;
}

QLabel#SidebarProfileHint {
    background-color: transparent;
    color: #7b8394;
    font-size: 12px;
}

QLabel#SidebarStatus {
    background-color: transparent;
    color: #5c6474;
    font-size: 11px;
    padding: 5px;
}

/* =========================================================
   TÍTULOS
========================================================= */

QLabel#SectionTitle {
    background-color: transparent;
    color: #f7f8fa;
    font-size: 26px;
    font-weight: 700;
}

QLabel#SectionDescription {
    background-color: transparent;
    color: #737c8d;
    font-size: 13px;
}

QLabel#PageTitle {
    background-color: transparent;
    color: #f7f8fa;
    font-size: 24px;
    font-weight: 700;
}

QLabel#PageDescription {
    background-color: transparent;
    color: #737c8d;
    font-size: 13px;
}

/* =========================================================
   BOTÕES
========================================================= */

QPushButton {
    background-color: #232936;
    color: #d6dae3;
    border: 1px solid #2f3646;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #2c3444;
    border: 1px solid #3d4557;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #1c212c;
    border: 1px solid #333b4c;
}

QPushButton:disabled {
    background-color: #181c25;
    color: #4a5160;
    border: 1px solid #232936;
}

QPushButton#DeckHeaderAction,
QPushButton#AddButton,
QPushButton#NewDeckButton,
QPushButton#AddCardsButton {
    background-color: #d4a84b;
    color: #14161d;
    border: none;
    border-radius: 9px;
    padding: 9px 18px;
    font-weight: 700;
}

QPushButton#DeckHeaderAction:hover,
QPushButton#AddButton:hover,
QPushButton#NewDeckButton:hover,
QPushButton#AddCardsButton:hover {
    background-color: #e6c77b;
}

QPushButton#DeckHeaderAction:pressed,
QPushButton#AddButton:pressed,
QPushButton#NewDeckButton:pressed,
QPushButton#AddCardsButton:pressed {
    background-color: #b08a35;
}

QPushButton#DeckHeaderAction:disabled,
QPushButton#AddButton:disabled,
QPushButton#NewDeckButton:disabled,
QPushButton#AddCardsButton:disabled {
    background-color: #4a4434;
    color: #8a8068;
}

QPushButton#DeckToolbarButton,
QPushButton#ToolbarButton,
QPushButton#ExportButton {
    background-color: #232936;
    color: #cdd2dd;
    border: 1px solid #2f3646;
    border-radius: 8px;
    padding: 7px 14px;
    font-weight: 600;
}

QPushButton#DeckToolbarButton:hover,
QPushButton#ToolbarButton:hover,
QPushButton#ExportButton:hover {
    background-color: #2c3444;
    border: 1px solid #455068;
    color: #ffffff;
}

QPushButton#PriceReferenceButton {
    background-color: #232936;
    color: #e4c36b;
    border: 1px solid #3d3a26;
    border-radius: 8px;
    padding: 7px 14px;
    font-weight: 600;
}

QPushButton#PriceReferenceButton:hover {
    background-color: #26291f;
    border: 1px solid #d4a84b;
    color: #f0d589;
}

QPushButton#PriceReferenceButton:pressed {
    background-color: #2e311f;
}

QPushButton#PriceReferenceButton:disabled {
    background-color: #161a23;
    color: #7a7040;
    border: 1px solid #2f3646;
}

QPushButton#DeckDeleteButton {
    background-color: transparent;
    color: #8a93a3;
    border: 1px solid #2f3646;
    border-radius: 8px;
    padding: 7px 14px;
    font-weight: 600;
}

QPushButton#DeckDeleteButton:hover {
    background-color: #2b1d20;
    border: 1px solid #5a3540;
    color: #e8a2aa;
}

QPushButton#DeckDeleteButton:pressed {
    background-color: #221619;
}

/* =========================================================
   CAMPOS
========================================================= */

QLineEdit {
    background-color: #161a23;
    border: 1px solid #2a3040;
    border-radius: 9px;
    padding: 9px 13px;
    color: #f2f4f8;
    selection-background-color: #3a4253;
    selection-color: #ffffff;
    font-size: 13px;
}

QLineEdit:hover {
    border: 1px solid #38405a;
}

QLineEdit:focus {
    border: 1px solid #d4a84b;
    background-color: #181d28;
}

QLineEdit:disabled {
    background-color: #12151d;
    color: #4a5160;
    border: 1px solid #232936;
}

QFrame#DeckPanelSearchFrame,
QFrame#SearchFrame,
QFrame#AddFrame {
    background-color: #161a23;
    border: 1px solid #2a3040;
    border-radius: 10px;
}

QFrame#DeckPanelSearchFrame:hover,
QFrame#SearchFrame:hover,
QFrame#AddFrame:hover {
    border: 1px solid #38405a;
}

QFrame#DeckPanelSearchFrame:focus-within,
QFrame#SearchFrame:focus-within,
QFrame#AddFrame:focus-within {
    border: 1px solid #d4a84b;
}

QLabel#SearchIcon {
    background-color: transparent;
    border: none;
}

/* CAMPO INTERNO — SEM SEGUNDA CAIXA */
QFrame#SearchFrame QLineEdit,
QFrame#AddFrame QLineEdit {
    background-color: transparent;
    border: none;
    border-radius: 0;
    padding: 10;
    outline: none;
}

QLabel#SearchIcon,
QLabel#AddIcon {
    background-color: transparent;
    color: #6b7486;
    font-size: 15px;
}

/* =========================================================
   SEARCH BAR (DECKS)
========================================================= */

QFrame#DeckSearchBar {
    background-color: #161a23;
    border: 1px solid #2a3040;
    border-radius: 10px;
}

QFrame#DeckSearchBar:focus-within {
    border: 1px solid #d4a84b;
}

QFrame#DeckSearchBar QLineEdit {
    background-color: transparent;
    border: none;
    padding: 8px 4px;
}

QFrame#DeckSearchBar QLineEdit:focus {
    border: none;
    background-color: transparent;
}

/* =========================================================
   ABAS DE FILTRO (DECKS)
========================================================= */

QFrame#DeckFilterBar {
    background-color: #161a23;
    border: 1px solid #232936;
    border-radius: 10px;
    padding: 3px;
}

QPushButton#DeckFilterTab {
    background-color: transparent;
    color: #8b93a3;
    border: none;
    border-radius: 7px;
    padding: 7px 16px;
    font-weight: 600;
}

QPushButton#DeckFilterTab:hover {
    background-color: #1e2330;
    color: #d6dae3;
}

QPushButton#DeckFilterTab:checked {
    background-color: #292f3d;
    color: #f2f4f8;
    border: 1px solid #3a4253;
}

/* =========================================================
   COMBOBOX
========================================================= */

QComboBox {
    background-color: #161a23;
    color: #d6dae3;
    border: 1px solid #2a3040;
    border-radius: 8px;
    padding: 7px 12px;
    min-height: 18px;
    font-size: 13px;
}

QComboBox:hover {
    background-color: #1a1f2a;
    border: 1px solid #38405a;
}

QComboBox:focus {
    border: 1px solid #d4a84b;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: none;
    border: none;
    width: 7px;
    height: 7px;
    background-color: #8b93a3;
    border-radius: 2px;
}

QComboBox QAbstractItemView {
    background-color: #1a1e29;
    color: #e8ebf2;
    border: 1px solid #2f3646;
    selection-background-color: #292f3d;
    selection-color: #ffffff;
    padding: 4px;
    outline: none;
}




/* =========================================================
   FILTROS DA COLLECTION
========================================================= */

/* ---------------------------------------------------------
   BOTÕES DOS FILTROS
--------------------------------------------------------- */

QPushButton#MultiSelectFilterButton {
    background-color: #161a23;
    color: #d6dae3;
    border: 1px solid #2a3040;
    border-radius: 8px;
    padding: 7px 12px;
    min-height: 18px;
    font-size: 13px;
    font-weight: 600;
    text-align: left;
}

QPushButton#MultiSelectFilterButton:hover {
    background-color: #1a1f2a;
    border: 1px solid #38405a;
    color: #ffffff;
}

QPushButton#MultiSelectFilterButton:pressed {
    background-color: #202632;
    border: 1px solid #4a5367;
}

QPushButton#MultiSelectFilterButton:focus {
    border: 1px solid #d4a84b;
}


/* ---------------------------------------------------------
   MENU DOS FILTROS
--------------------------------------------------------- */

QPushButton#MultiSelectFilterButton QMenu {
    background-color: #181c26;
    color: #e8ebf2;
    border: 1px solid #30384a;
    border-radius: 12px;
    padding: 1px;
}


/* ---------------------------------------------------------
   ÁREA INTERNA DO MENU
--------------------------------------------------------- */

QPushButton#MultiSelectFilterButton QScrollArea {
    background-color: transparent;
    border: none;
}


/* ---------------------------------------------------------
   CHECKBOXES
--------------------------------------------------------- */

QPushButton#MultiSelectFilterButton QCheckBox {
    background-color: transparent;
    color: #cfd4df;
    border: none;
    border-radius: 6px;
    padding: 6px 8px;
    spacing: 8px;
    min-height: 24px;
}

QPushButton#MultiSelectFilterButton QCheckBox:hover {
    background-color: #292f3d;
    color: #ffffff;
}

QPushButton#MultiSelectFilterButton QCheckBox:checked {
    background-color: #292f3d;
    color: #ffffff;
    font-weight: 600;
}


/* =========================================================
   TODAS
========================================================= */

QWidget#CollectionFilterMenu QCheckBox[filterOption="all"] {
    color: #d4a84b;
    font-weight: 700;
}

QWidget#CollectionFilterMenu QCheckBox[filterOption="all"]:hover {
    background-color: #222936;
    color: #e6c77b;
}

QWidget#CollectionFilterMenu QCheckBox[filterOption="all"]:checked {
    background-color: #252d3b;
    color: #e6c77b;
}


/* ---------------------------------------------------------
   SEPARADOR DOS FILTROS
--------------------------------------------------------- */

QWidget#CollectionFilterSeparator {
    background-color: #2c3443;
    border: none;
    min-height: 1px;
    max-height: 1px;
    margin: 3px 2px;
}


/* =========================================================
   CONTAINER DO MENU DE FILTRO
   ========================================================= */

QWidget#CollectionFilterMenu {
    background-color: #181c26;
    color: #e8ebf2;
    border: none;
    border-radius: 10px;
}


/* ---------------------------------------------------------
   OPÇÕES DO FILTRO
--------------------------------------------------------- */

QWidget#CollectionFilterMenu QCheckBox {
    background-color: transparent;
    color: #cdd3df;
    border: none;
    border-radius: 7px;
    padding: 6px 9px;
    spacing: 9px;
    min-height: 26px;
}

QWidget#CollectionFilterMenu QCheckBox:hover {
    background-color: #222936;
    color: #ffffff;
}

QWidget#CollectionFilterMenu QCheckBox:checked {
    background-color: #252d3b;
    color: #ffffff;
    font-weight: 600;
}


/* ---------------------------------------------------------
   CHECKBOX MARCADO
--------------------------------------------------------- */

QWidget#CollectionFilterMenu QCheckBox:checked {
    background-color: #292f3d;
    color: #ffffff;
    font-weight: 600;
}


/* ---------------------------------------------------------
   CHECKBOX
--------------------------------------------------------- */

QWidget#CollectionFilterMenu QCheckBox::indicator {
    width: 16px;
    height: 16px;

    background-color: #141820;

    border: 1px solid #3a4354;
    border-radius: 5px;
}

QWidget#CollectionFilterMenu QCheckBox::indicator:hover {
    background-color: #1d2430;
    border: 1px solid #687388;
}

QWidget#CollectionFilterMenu QCheckBox::indicator:checked {
    background-color: #d4a84b;
    border: 1px solid #d4a84b;
}

/* =========================================================
   CORES DOS FILTROS
========================================================= */

QWidget#CollectionFilterMenu QCheckBox[filterColor="W"]:checked {
    background-color: #eeeeee;
    color: #151820;
}

QWidget#CollectionFilterMenu QCheckBox[filterColor="U"]:checked {
    background-color: #3f82c4;
    color: #ffffff;
}

QWidget#CollectionFilterMenu QCheckBox[filterColor="B"]:checked {
    background-color: #3b3b44;
    color: #ffffff;
}

QWidget#CollectionFilterMenu QCheckBox[filterColor="R"]:checked {
    background-color: #bd4c4c;
    color: #ffffff;
}

QWidget#CollectionFilterMenu QCheckBox[filterColor="G"]:checked {
    background-color: #4d9360;
    color: #ffffff;
}

QWidget#CollectionFilterMenu QCheckBox[filterColor="C"]:checked {
    background-color: #9ba2ad;
    color: #151820;
}

QWidget#CollectionFilterMenu QCheckBox[filterColor="M"]:checked {
    background-color: #a96f42;
    color: #ffffff;
}

/* =========================================================
   CORES — FILTRO DE COR
========================================================= */

/* Branco */
QPushButton#MultiSelectFilterButton QCheckBox[filterOption="color_W"]:checked {
    background-color: #e8e8e8;
    color: #161a23;
}

/* Azul */
QPushButton#MultiSelectFilterButton QCheckBox[filterOption="color_U"]:checked {
    background-color: #3f8fd2;
    color: #ffffff;
}

/* Preto */
QPushButton#MultiSelectFilterButton QCheckBox[filterOption="color_B"]:checked {
    background-color: #3a3a42;
    color: #ffffff;
}

/* Vermelho */
QPushButton#MultiSelectFilterButton QCheckBox[filterOption="color_R"]:checked {
    background-color: #c94a4a;
    color: #ffffff;
}

/* Verde */
QPushButton#MultiSelectFilterButton QCheckBox[filterOption="color_G"]:checked {
    background-color: #4f9b62;
    color: #ffffff;
}

/* Incolor */
QPushButton#MultiSelectFilterButton QCheckBox[filterOption="color_C"]:checked {
    background-color: #9da3ad;
    color: #161a23;
}

/* Multicolor */
QPushButton#MultiSelectFilterButton QCheckBox[filterOption="color_M"]:checked {
    background-color: #b07a42;
    color: #ffffff;
}

/* =========================================================
   RARIDADES
========================================================= */

QPushButton#MultiSelectFilterButton QCheckBox[filterOption="rarity_common"]:checked {
    background-color: #666d78;
    color: #ffffff;
}

QPushButton#MultiSelectFilterButton QCheckBox[filterOption="rarity_uncommon"]:checked {
    background-color: #7c8a9c;
    color: #ffffff;
}

QPushButton#MultiSelectFilterButton QCheckBox[filterOption="rarity_rare"]:checked {
    background-color: #b08a35;
    color: #ffffff;
}

QPushButton#MultiSelectFilterButton QCheckBox[filterOption="rarity_mythic"]:checked {
    background-color: #a64d32;
    color: #ffffff;
}

QPushButton#MultiSelectFilterButton QCheckBox[filterOption="rarity_special"]:checked {
    background-color: #7659a8;
    color: #ffffff;
}

QPushButton#MultiSelectFilterButton QCheckBox[filterOption="rarity_bonus"]:checked {
    background-color: #4f8f83;
    color: #ffffff;
}



/* =========================================================
   TIPOS
========================================================= */

QPushButton#MultiSelectFilterButton QCheckBox[filterOption^="type_"]:checked {
    background-color: #292f3d;
    color: #e6c77b;
}


/* =========================================================
   SUPERTIPOS
========================================================= */

QPushButton#MultiSelectFilterButton QCheckBox[filterOption^="supertype_"]:checked {
    background-color: #292f3d;
    color: #d4a84b;
}

/* =========================================================
   EDIÇÃO
========================================================= */

QPushButton#MultiSelectFilterButton QCheckBox[filterOption="edition"]:checked {
    background-color: #292f3d;
    color: #e6c77b;
    font-weight: 600;
}


/* =========================================================
   MENUS
========================================================= */

QMenu {
    background-color: #1a1e29;
    color: #e8ebf2;
    border: 1px solid #2f3646;
    border-radius: 8px;
    padding: 5px;
}

QMenu::item {
    padding: 7px 22px 7px 12px;
    border-radius: 6px;
    color: #cfd4df;
}

QMenu::item:selected {
    background-color: #292f3d;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #4a5160;
}

QMenu::separator {
    height: 1px;
    background-color: #2c3342;
    margin: 4px 8px;
}

/* =========================================================
   FUNDO DOS FILTROS
========================================================= */



QWidget#CollectionFilterMenu QScrollArea {
    background-color: transparent;
    border: none;
}

QWidget#CollectionFilterMenu QScrollArea > QWidget {
    background-color: transparent;
    border: none;
}

QWidget#CollectionFilterMenu QScrollArea > QWidget > QWidget {
    background-color: transparent;
    border: none;
}




/* =========================================================
   SCROLL AREAS
========================================================= */

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea#CardsScrollArea,
QScrollArea#DecksScrollArea {
    background-color: transparent;
    border: none;
    padding: 0;
}

QScrollArea#CardsScrollArea > QWidget,
QScrollArea#DecksScrollArea > QWidget,
QScrollArea#CardsScrollArea > QWidget > QWidget,
QScrollArea#DecksScrollArea > QWidget > QWidget {
    background-color: transparent;
    border: none;
}

/* =========================================================
   SCROLLBAR
========================================================= */

QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    border: none;
    margin: 2px 1px 2px 2px;
}

QScrollBar::handle:vertical {
    background-color: #2c3342;
    border: none;
    border-radius: 5px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background-color: #3d4557;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    background: none;
    border: none;
    height: 0;
    width: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
    border: none;
    margin: 1px 2px;
}

QScrollBar::handle:horizontal {
    background-color: #2c3342;
    border: none;
    border-radius: 5px;
    min-width: 40px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #3d4557;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    background: none;
    border: none;
    width: 0;
    height: 0;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* =========================================================
   DECKS — GRID
========================================================= */

QFrame#DeckPreviewFrame {
    background-color: #181c26;
    border: 1px solid #272e3d;
    border-radius: 14px;
}

QFrame#DeckPreviewFrame:hover {
    background-color: #1d2230;
    border: 1px solid #d4a84b;
}

QFrame#DeckPreviewFrame[hover="true"] {
    background-color: #1d2230;
    border: 1px solid #d4a84b;
}

QFrame#DeckPreviewImageArea {
    background-color: transparent;
    border: none;
}

QLabel#DeckPreviewCard {
    background-color: transparent;
    border: none;
}

QLabel#DeckPreviewName {
    background-color: transparent;
    color: #eef0f5;
    font-size: 14px;
    font-weight: 700;
}

QLabel#DeckPreviewTotal {
    background-color: transparent;
    color: #8b93a3;
    font-size: 12px;
}

QFrame#DeckPreviewFrame:hover QLabel#DeckPreviewName {
    color: #e6c77b;
}

QFrame#DeckPreviewFrame:hover QLabel#DeckPreviewTotal {
    color: #aeb5c2;
}

QFrame#NewDeckFrame,
QFrame#NewDeckCard {
    background-color: transparent;
    border: 1px dashed #3d4557;
    border-radius: 14px;
}

QFrame#NewDeckFrame:hover,
QFrame#NewDeckCard:hover {
    background-color: #171b25;
    border: 1px solid #d4a84b;
}

QLabel#NewDeckPlus {
    background-color: transparent;
    color: #6b7486;
    font-size: 48px;
    font-weight: 300;
}

QLabel#NewDeckText {
    background-color: transparent;
    color: #8b93a3;
    font-size: 14px;
    font-weight: 500;
}

QFrame#NewDeckFrame:hover QLabel#NewDeckPlus {
    color: #d4a84b;
}

QFrame#NewDeckFrame:hover QLabel#NewDeckText {
    color: #e6e8ee;
}

/* =========================================================
   PAGINAÇÃO
========================================================= */

QWidget#PaginationBar QLabel {
    background-color: transparent;
    color: #737c8d;
    font-size: 12px;
}

QPushButton#PageButton {
    background-color: transparent;
    color: #9aa2b1;
    border: 1px solid transparent;
    border-radius: 6px;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    padding: 0;
    font-weight: 600;
}

QPushButton#PageButton:hover {
    background-color: #232936;
    color: #ffffff;
}

QPushButton#PageButton:checked {
    background-color: #d4a84b;
    color: #14161d;
    border: none;
    font-weight: 700;
}

/* =========================================================
