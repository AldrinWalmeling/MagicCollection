}

QLabel#DashboardMuted {
    background-color: transparent;

    color: #60656E;

    font-size: 11px;
}


/* =========================================================
   CORES
========================================================= */

QLabel#DashboardColorDot {
    border-radius: 4px;

    background-color: #666C75;
}

QLabel#DashboardColorDot[color="White"] {
    background-color: #E5E0D3;
}

QLabel#DashboardColorDot[color="Blue"] {
    background-color: #4B82C4;
}

QLabel#DashboardColorDot[color="Black"] {
    background-color: #777B83;
}

QLabel#DashboardColorDot[color="Red"] {
    background-color: #B9574F;
}

QLabel#DashboardColorDot[color="Green"] {
    background-color: #568A60;
}

QLabel#DashboardColorDot[color="Colorless"] {
    background-color: #92969C;
}

QLabel#DashboardColorDot[color="Multi"] {
    background-color: #B39A54;
}


/* =========================================================
   BARRAS DE COR
========================================================= */

QProgressBar#DashboardColorBar {
    background-color: #202329;

    border: none;
    border-radius: 4px;
}

QProgressBar#DashboardColorBar::chunk {
    background-color: #6C727C;

    border-radius: 4px;
}

QProgressBar#DashboardColorBar[color="White"]::chunk {
    background-color: #B8B0A0;
}

QProgressBar#DashboardColorBar[color="Blue"]::chunk {
    background-color: #477BB7;
}

QProgressBar#DashboardColorBar[color="Black"]::chunk {
    background-color: #666A73;
}

QProgressBar#DashboardColorBar[color="Red"]::chunk {
    background-color: #A94F49;
}

QProgressBar#DashboardColorBar[color="Green"]::chunk {
    background-color: #4F825A;
}

QProgressBar#DashboardColorBar[color="Colorless"]::chunk {
    background-color: #80858D;
}

QProgressBar#DashboardColorBar[color="Multi"]::chunk {
    background-color: #AD9450;
}


/* =========================================================
   RARIDADES
========================================================= */

QProgressBar#DashboardRarityBar {
    background-color: #202329;

    border: none;
    border-radius: 4px;
}

QProgressBar#DashboardRarityBar::chunk {
    background-color: #777D87;

    border-radius: 4px;
}


