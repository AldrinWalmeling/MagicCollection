/* =========================================================
   CARDS SUPERIORES
   ========================================================= */

QFrame#DashboardStatCard {
    background-color: #171a22;
    border: 1px solid #272d3a;
    border-radius: 11px;

    min-height: 96px;
}

QFrame#DashboardStatCard:hover {
    background-color: #1b1f29;
    border: 1px solid #394253;
}

QLabel#DashboardStatTitle {
    background: transparent;
    color: #737d8f;

    font-size: 10px;
    font-weight: 700;
}

QLabel#DashboardStatValue {
    background: transparent;
    color: #f5f6f8;

    font-size: 24px;
    font-weight: 700;
}

QLabel#DashboardStatDescription {
    background: transparent;
    color: #606a7b;

    font-size: 10px;
}


/* =========================================================
   PAINÉIS
   ========================================================= */

QFrame#DashboardPanel,
QFrame#DashboardDeckPanel {
    background-color: #171a22;

    border: 1px solid #272d3a;
    border-radius: 11px;
}

QLabel#DashboardPanelTitle {
    background: transparent;
    color: #edf0f5;

    font-size: 14px;
    font-weight: 700;
}

QLabel#DashboardPanelSubtitle {
    background: transparent;
    color: #667084;

    font-size: 10px;
}

QLabel#DashboardRowLabel {
    background: transparent;
    color: #aeb5c2;

    font-size: 11px;
}

QLabel#DashboardRowValue {
    background: transparent;
    color: #e6e9ee;

    font-size: 11px;
    font-weight: 600;
}


/* =========================================================
   SÍMBOLOS DE MANA
   ========================================================= */

QLabel#DashboardManaSymbol {
    border-radius: 11px;

    font-size: 10px;
    font-weight: 800;
}

QLabel#DashboardManaSymbol[color="White"] {
    background-color: #e7e2d6;
    color: #4b4a47;
}

QLabel#DashboardManaSymbol[color="Blue"] {
    background-color: #4b83c4;
    color: #ffffff;
}

QLabel#DashboardManaSymbol[color="Black"] {
    background-color: #242831;
    color: #d5d9e0;
    border: 1px solid #4a505c;
}

QLabel#DashboardManaSymbol[color="Red"] {
    background-color: #b6534b;
    color: #ffffff;
}

QLabel#DashboardManaSymbol[color="Green"] {
    background-color: #52845d;
    color: #ffffff;
}

QLabel#DashboardManaSymbol[color="Colorless"] {
    background-color: #858b95;
    color: #171a20;
}

QLabel#DashboardManaSymbol[color="Multi"] {
    background-color: #c0a64e;
    color: #171a20;
}


/* =========================================================
   BARRAS DE CORES
   ========================================================= */

QProgressBar#DashboardColorBar {
    background-color: #20242c;
    border: none;
    border-radius: 4px;
}

QProgressBar#DashboardColorBar::chunk {
    border-radius: 4px;
}

QProgressBar#DashboardColorBar[color="White"]::chunk {
    background-color: #c8c1b1;
}

QProgressBar#DashboardColorBar[color="Blue"]::chunk {
    background-color: #4b83c4;
}

QProgressBar#DashboardColorBar[color="Black"]::chunk {
    background-color: #626873;
}

QProgressBar#DashboardColorBar[color="Red"]::chunk {
    background-color: #b6534b;
}

QProgressBar#DashboardColorBar[color="Green"]::chunk {
    background-color: #52845d;
}

QProgressBar#DashboardColorBar[color="Colorless"]::chunk {
    background-color: #858b95;
}

QProgressBar#DashboardColorBar[color="Multi"]::chunk {
    background-color: #c0a64e;
}


/* =========================================================
   RARIDADES
   ========================================================= */

QProgressBar#DashboardRarityBar {
    background-color: #20242c;
    border: none;
    border-radius: 4px;
}

QProgressBar#DashboardRarityBar::chunk {
    border-radius: 4px;
}

QProgressBar#DashboardRarityBar[rarity="Comum"]::chunk {
    background-color: #858b95;
}

QProgressBar#DashboardRarityBar[rarity="Incomum"]::chunk {
    background-color: #aeb6c4;
}

QProgressBar#DashboardRarityBar[rarity="Rara"]::chunk {
    background-color: #c9a84e;
}

QProgressBar#DashboardRarityBar[rarity="Mítica"]::chunk {
    background-color: #c76b3c;
}

QProgressBar#DashboardRarityBar[rarity="Sem raridade"]::chunk {
    background-color: #515866;
}


/* =========================================================
   CURVA DE MANA — NOVO
   ========================================================= */

QFrame#DashboardManaTrack {
    background-color: #20242c;

    border: 1px solid #2b3240;
    border-radius: 6px;
}

QFrame#DashboardManaFill {
    background-color: #d4a84b;

    border: none;
    border-radius: 5px;
}

QLabel#DashboardManaValue {
    background: transparent;
    color: #dfe3e9;

    font-size: 10px;
    font-weight: 700;
}

QLabel#DashboardManaLabel {
    background: transparent;
    color: #858e9f;

    font-size: 10px;
    font-weight: 700;
}


/* =========================================================
   EDIÇÕES
   ========================================================= */

QLabel#DashboardSetName {
    background: transparent;
    color: #c0c6d0;

    font-size: 11px;
    font-weight: 600;
}

QProgressBar#DashboardSetBar {
    background-color: #20242c;

    border: none;
    border-radius: 3px;
}

QProgressBar#DashboardSetBar::chunk {
    border-radius: 3px;
}

QProgressBar#DashboardSetBar[setIndex="0"]::chunk {
    background-color: #d4a84b;
}

QProgressBar#DashboardSetBar[setIndex="1"]::chunk {
    background-color: #5c84bd;
}

QProgressBar#DashboardSetBar[setIndex="2"]::chunk {
    background-color: #668b67;
}

QProgressBar#DashboardSetBar[setIndex="3"]::chunk {
    background-color: #9a6caf;
}

QProgressBar#DashboardSetBar[setIndex="4"]::chunk {
    background-color: #b46b57;
}

QProgressBar#DashboardSetBar[setIndex="5"]::chunk {
    background-color: #71808e;
}


/* =========================================================
   CARTAS RECENTES
   ========================================================= */

QFrame#DashboardRecentCard {
    background-color: #12151b;

    border: 1px solid transparent;
    border-radius: 8px;
}

QFrame#DashboardRecentCard:hover {
    background-color: #1c2029;
    border: 1px solid #303847;
}

QLabel#DashboardRecentImage {
    background-color: #0c0f14;

    border: 1px solid #2b3240;
    border-radius: 5px;
}

QLabel#DashboardRecentName {
    color: #e0e4ea;
    font-size: 11px;
    font-weight: 600;
}

QLabel#DashboardRecentMeta {
    color: #697385;
    font-size: 9px;
}

QLabel#DashboardRecentQuantity {
    color: #c5cbd5;
    font-size: 11px;
    font-weight: 700;
}


/* =========================================================
   DECKS
   ========================================================= */

QFrame#DashboardDeckCard {
    background-color: #12151b;

    border: 1px solid #292f3c;
    border-radius: 9px;
}

QFrame#DashboardDeckCard:hover {
    background-color: #1c2029;
    border: 1px solid #d4a84b;
}

QLabel#DashboardDeckImage {
    background-color: #0c0f14;

    border: 1px solid #2b3240;
    border-radius: 5px;
}

QLabel#DashboardDeckName {
    background: transparent;
    color: #e0e4ea;

    font-size: 12px;
    font-weight: 700;
}

QFrame#DashboardDeckCard:hover QLabel#DashboardDeckName {
    color: #e4c36b;
}

QLabel#DashboardDeckCards {
    background: transparent;
    color: #727d8f;

    font-size: 10px;
}

QFrame#DashboardDeckCurveBar {
    background-color: #1a1f2a;
    border-radius: 2px;
}

QFrame#DashboardDeckCurveFill {
    background-color: #d4a84b;
    border-radius: 2px;
}

/* =========================================================
   CARTAS MAIS VALIOSAS
   ========================================================= */

QFrame#DashboardTopCards {
    background-color: #15171B;
    border: 1px solid #292D34;
    border-radius: 12px;
}

QLabel#DashboardTopHeroImage {
    background-color: #0c0f14;
    border: 1px solid #3d3a26;
    border-radius: 5px;
}

QLabel#DashboardTopHeroName {
    background: transparent;
    color: #f0f2f6;
    font-size: 17px;
    font-weight: 700;
}

QLabel#DashboardTopHeroPrice {
    background: transparent;
    color: #e4c36b;
    font-size: 22px;
    font-weight: 800;
}

QLabel#DashboardTopRarity {
    background-color: #232936;
    color: #c9a84e;
    border: 1px solid #3a4253;
    border-radius: 5px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 700;
}

QFrame#DashboardTopSmallCard {
    background-color: #12151b;
    border: 1px solid #3d3a26;
    border-radius: 9px;
}

QFrame#DashboardTopSmallCard:hover {
    background-color: #1c2029;
    border: 1px solid #d4a84b;
}

QLabel#DashboardTopSmallImage {
    background-color: #0c0f14;
    border: 1px solid #2b3240;
    border-radius: 4px;
}

QLabel#DashboardTopSmallName {
    background: transparent;
    color: #d8dce3;
    font-size: 12px;
    font-weight: 600;
}

QLabel#DashboardTopSmallPrice {
    background: transparent;
    color: #e4c36b;
    font-size: 13px;
    font-weight: 700;
}

QLabel#DashboardTypeIcon {
    background: transparent;
    color: #8b93a3;
    font-size: 14px;
}

/* =========================================================
   DECKS — FILTROS, ESTATÍSTICAS E GRUPOS
   ========================================================= */

QFrame#DeckFilterBar {
    background-color: #151821;
    border: 1px solid #2c3342;
    border-radius: 12px;
}

QLineEdit#DeckFilterSearch {
    background-color: #12161f;
    color: #eef0f5;
    border: 1px solid #2c3342;
    border-radius: 8px;
    padding: 7px 10px;
    font-size: 13px;
}

QLineEdit#DeckFilterSearch:focus {
    border: 1px solid #d4a84b;
}

QComboBox#DeckFilterCombo,
QComboBox#DeckFormatCombo {
    background-color: #232936;
    color: #d6dae3;
    border: 1px solid #2f3646;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 12px;
}

QComboBox#DeckFilterCombo:hover,
QComboBox#DeckFormatCombo:hover {
    border: 1px solid #455068;
}

QComboBox#DeckFilterCombo::drop-down,
QComboBox#DeckFormatCombo::drop-down {
    border: none;
    width: 18px;
}

QComboBox#DeckFilterCombo QAbstractItemView,
QComboBox#DeckFormatCombo QAbstractItemView {
    background-color: #1a1e29;
    color: #d6dae3;
    border: 1px solid #2f3646;
    selection-background-color: #2c3444;
    outline: none;
}

QPushButton#DeckColorFilterButton {
    background-color: #1a1e29;
    border: 1px solid #2f3646;
    border-radius: 15px;
    padding: 0px;
    margin: 0px;
    min-width: 0px;
}

QPushButton#DeckColorFilterButton:hover {
    border: 1px solid #455068;
}

QPushButton#DeckColorFilterButton[pip="w"]:checked {
    background-color: #f2e6c8;
    border: 2px solid #ffffff;
}

QPushButton#DeckColorFilterButton[pip="u"]:checked {
    background-color: #4a86c8;
    border: 2px solid #ffffff;
}

QPushButton#DeckColorFilterButton[pip="b"]:checked {
    background-color: #6f5f80;
    border: 2px solid #ffffff;
}

QPushButton#DeckColorFilterButton[pip="r"]:checked {
    background-color: #d4574a;
    border: 2px solid #ffffff;
}

QPushButton#DeckColorFilterButton[pip="g"]:checked {
    background-color: #4f9d68;
    border: 2px solid #ffffff;
}

QPushButton#DeckColorFilterButton[pip="c"]:checked {
    background-color: #8b93a3;
    border: 2px solid #ffffff;
}

QLabel#DeckColorPip {
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
    color: #12161f;
}

QLabel#DeckColorPip[pip="w"] { background-color: #f2e6c8; }
QLabel#DeckColorPip[pip="u"] { background-color: #4a86c8; color: #ffffff; }
QLabel#DeckColorPip[pip="b"] { background-color: #6f5f80; color: #ffffff; }
QLabel#DeckColorPip[pip="r"] { background-color: #d4574a; color: #ffffff; }
QLabel#DeckColorPip[pip="g"] { background-color: #4f9d68; color: #ffffff; }
QLabel#DeckColorPip[pip="c"] { background-color: #8b93a3; color: #12161f; }

QLabel#DeckColorPip[empty="true"] {
    background-color: #1a1e29;
    color: #4a5160;
    border: 1px solid #272e3d;
}

QLabel#DeckValidationLabel {
    background-color: #12161f;
    border: 1px solid #272e3d;
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 12px;
    color: #9aa2b1;
}

QLabel#DeckValidationLabel[state="ok"] {
    background-color: #14241a;
    border: 1px solid #2f6b43;
    color: #7fd39b;
}

QLabel#DeckValidationLabel[state="warning"] {
    background-color: #241f12;
    border: 1px solid #6b5a2f;
    color: #e6c77b;
}

QLabel#DeckValidationLabel[state="error"] {
    background-color: #251517;
    border: 1px solid #6b2f36;
    color: #e79a9a;
}

QFrame#DeckGroupHeader {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid #272e3d;
}

QLabel#DeckGroupTitle {
    background-color: transparent;
    color: #eef0f5;
    font-size: 14px;
    font-weight: 700;
}

QLabel#DeckGroupCount {
    background-color: #232936;
    color: #b6bdcb;
    border: 1px solid #2f3646;
    border-radius: 8px;
    padding: 1px 8px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#DeckFormatBadge {
    background-color: #232936;
    color: #b6bdcb;
    border: 1px solid #2f3646;
    border-radius: 8px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 700;
}

QScrollArea#DeckStatsSidebarScroll {
    background-color: transparent;
    border: none;
}

QScrollArea#DeckStatsSidebarScroll > QWidget > QWidget {
    background-color: transparent;
}

/* =========================================================
   DASHBOARD — REDESIGN (ícones, hover, ranking, chips)
   ========================================================= */

/* ---------- HOVER SUTIL DOS PAINÉIS ---------- */

QFrame#DashboardDistributionPanel:hover,
QFrame#DashboardBottomPanel:hover,
QFrame#DashboardManaCurvePanel:hover,
QFrame#DashboardTopCards:hover {
    background-color: #191d26;
    border: 1px solid #323b4b;
}

/* ---------- ÍCONES CIRCULARES DOS STAT CARDS ---------- */

QFrame#DashboardStatIcon {
    border-radius: 29px;
    border: 1px solid #2b3240;
    background-color: #161a23;
}

QFrame#DashboardStatIcon[variant="collection"] {
    border: 1px solid #4a4128;
    background: qradialgradient(
        cx: 0.5, cy: 0.5, radius: 0.65, fx: 0.5, fy: 0.4,
        stop: 0 rgba(212, 168, 75, 0.38),
        stop: 1 rgba(22, 26, 35, 0.92)
    );
}

QFrame#DashboardStatIcon[variant="unique"] {
    border: 1px solid #24364c;
    background: qradialgradient(
        cx: 0.5, cy: 0.5, radius: 0.65, fx: 0.5, fy: 0.4,
        stop: 0 rgba(92, 132, 189, 0.38),
        stop: 1 rgba(22, 26, 35, 0.92)
    );
}

QFrame#DashboardStatIcon[variant="decks"] {
    border: 1px solid #2a3d2c;
    background: qradialgradient(
        cx: 0.5, cy: 0.5, radius: 0.65, fx: 0.5, fy: 0.4,
        stop: 0 rgba(102, 139, 103, 0.38),
        stop: 1 rgba(22, 26, 35, 0.92)
    );
}

QFrame#DashboardStatIcon[variant="value"] {
    border: 1px solid #4a2e26;
    background: qradialgradient(
        cx: 0.5, cy: 0.5, radius: 0.65, fx: 0.5, fy: 0.4,
        stop: 0 rgba(199, 107, 60, 0.38),
        stop: 1 rgba(22, 26, 35, 0.92)
    );
}

QLabel#DashboardStatIconGlyph {
    background: transparent;
    color: #b9c0cc;
    font-size: 20px;
    font-weight: 700;
}

QFrame#DashboardStatIcon[variant="collection"] QLabel#DashboardStatIconGlyph {
    color: #e4c36b;
}

QFrame#DashboardStatIcon[variant="unique"] QLabel#DashboardStatIconGlyph {
    color: #7ba6d8;
}

QFrame#DashboardStatIcon[variant="decks"] QLabel#DashboardStatIconGlyph {
    color: #86b388;
}

QFrame#DashboardStatIcon[variant="value"] QLabel#DashboardStatIconGlyph {
    color: #e08a5c;
}

QFrame#DashboardStatCard:hover {
    background-color: #1a1e27;
    border: 1px solid #3d4759;
}

/* ---------- RANKING ---------- */

QLabel#DashboardRankBadge {
    background-color: #2a2f3a;
    border: 1px solid #3a4253;
    border-radius: 13px;
    color: #e4c36b;
    font-size: 10px;
    font-weight: 800;
}

/* ---------- CARTA DESTAQUE (TOP 1) ---------- */

QFrame#DashboardTopHeroCard {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 12px;
}

QFrame#DashboardTopHeroCard:hover {
    background-color: #171b24;
    border: 1px solid #3d4759;
}

QFrame#DashboardTopHeroCard:hover QLabel#DashboardTopHeroImage {
    border: 1px solid #d4a84b;
}

QFrame#DashboardTopHeroCard:hover QLabel#DashboardTopHeroPrice {
    color: #f0d589;
}

QLabel#DashboardTopSetChip {
    background-color: #232936;
    color: #9aa4b5;
    border: 1px solid #2f3646;
    border-radius: 5px;
    padding: 2px 8px;
    font-size: 10px;
}

QLabel#DashboardTopMeta {
    background: transparent;
    color: #727d8f;
    font-size: 11px;
}

QLabel#DashboardTopTrend {
    background-color: #1c2420;
    color: #7fc98a;
    border: 1px solid #2a3a2e;
    border-radius: 5px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 700;
}

QLabel#DashboardTopTrend[trend="down"] {
    background-color: #241c1c;
    color: #d97a6a;
    border: 1px solid #3a2a2a;
}

QLabel#DashboardTopTrend[trend="flat"] {
    background-color: #1c1e24;
    color: #8b93a3;
    border: 1px solid #2b3038;
}

/* ---------- CARDS #2 E #3 ---------- */

QFrame#DashboardTopSmallCard:hover QLabel#DashboardTopSmallImage {
    border: 1px solid #d4a84b;
}

QFrame#DashboardTopSmallCard:hover QLabel#DashboardTopSmallPrice {
    color: #f0d589;
}

QLabel#DashboardTopSmallRarity {
    background: transparent;
    color: #8b93a3;
    font-size: 10px;
}

/* ---------- RARIDADE: INCOMUM AZUL ---------- */

QProgressBar#DashboardRarityBar[rarity="Incomum"]::chunk {
    background-color: #4B82C4;
}

/* ---------- TIPOS DE CARTA ---------- */

QLabel#DashboardTypeIcon[type="Criaturas"] {
    color: #d4a84b;
}

QLabel#DashboardTypeIcon[type="Mágicas"] {
    color: #5c84bd;
}

QLabel#DashboardTypeIcon[type="Artefatos"] {
    color: #8a93a3;
}

QLabel#DashboardTypeIcon[type="Encantamentos"] {
    color: #9a6caf;
}

QLabel#DashboardTypeIcon[type="Planeswalkers"] {
    color: #d97a5a;
}

QLabel#DashboardTypeIcon[type="Terrenos"] {
    color: #668b67;
}

QLabel#DashboardTypeIcon[type="Outros"] {
    color: #717d8e;
}

/* ---------- MANA CURVE — COMPACTA ---------- */

QFrame#DashboardManaCurvePanel {
    background-color: #15171B;
    border: 1px solid #292D34;
    border-radius: 10px;
}

QFrame#DashboardManaCurvePanel QLabel#DashboardPanelTitle {
    font-size: 13px;
}

QFrame#DashboardManaCurvePanel QLabel#DashboardPanelSubtitle {
    font-size: 9px;
}

/* ---------- INDICADOR "DADOS DA COLEÇÃO" ---------- */

QLabel#DashboardUpdated {
    background-color: #161a23;
    border: 1px solid #2b3240;
    border-radius: 9px;
    padding: 4px 12px;
    color: #8b93a3;
    font-size: 10px;
    font-weight: 600;
}

/* =========================================================
   DASHBOARD — CAIXAS CONSISTENTES (corrige painéis sem box)
   ========================================================= */

QFrame#DashboardDistributionPanel,
QFrame#DashboardBottomPanel,
QFrame#DashboardManaCurvePanel,
QFrame#DashboardTopCards,
QFrame#DashboardPanel {
    background-color: #181c25;
    border: 1px solid #2a3140;
    border-radius: 10px;
}

QFrame#DashboardDistributionPanel:hover,
QFrame#DashboardBottomPanel:hover,
QFrame#DashboardManaCurvePanel:hover,
QFrame#DashboardTopCards:hover,
QFrame#DashboardPanel:hover {
    background-color: #1f2430;
    border: 1px solid #3a445a;
    border-radius: 10px;
}

QFrame#DashboardDistributionPanel QLabel#DashboardPanelTitle,
QFrame#DashboardBottomPanel QLabel#DashboardPanelTitle,
QFrame#DashboardManaCurvePanel QLabel#DashboardPanelTitle,
QFrame#DashboardTopCards QLabel#DashboardPanelTitle {
    font-size: 14px;
    font-weight: 700;
}

/* ---------- HERO CARD — CONTAINER VISÍVEL ---------- */

QFrame#DashboardTopHeroCard {
    background-color: #141822;
    border: 1px solid #222a38;
    border-radius: 12px;
}

QFrame#DashboardTopHeroCard:hover {
    background-color: #191f2c;
    border: 1px solid #3d4759;
}

QFrame#DashboardTopHeroCard:hover QLabel#DashboardTopHeroImage {
    border: 1px solid #d4a84b;
}

QFrame#DashboardTopHeroCard:hover QLabel#DashboardTopHeroPrice {
    color: #f0d589;
}

QLabel#DashboardTopType {
    background: transparent;
    color: #828b9c;
    font-size: 11px;
}

QLabel#DashboardTopManaCost {
    background: transparent;
}

QLabel#DashboardDeckColor {
    background: transparent;
    font-size: 9px;
    font-weight: 700;
}

QLabel#DashboardTopFoil {
    background: transparent;
    color: #8f9aac;
    font-size: 10px;
    font-weight: 600;
}

QLabel#DashboardTopBest {
    background-color: #26291f;
    color: #e4c36b;
    border: 1px solid #3d3a26;
    border-radius: 5px;
    padding: 2px 8px;
    font-size: 9px;
    font-weight: 700;
}

/* ---------- HOVER SEM CANTOS QUADRADOS ---------- */

QFrame#DashboardDeckCard:hover,
QFrame#DashboardTopSmallCard:hover {
    border-radius: 9px;
}

QFrame#DashboardRecentCard:hover {
    border-radius: 8px;
}

QFrame#DashboardTopHeroCard:hover {
    border-radius: 12px;
}

/* =========================================================
   TOP 5 CARTAS MAIS VALIOSAS (RANKING COMPACTO)
   ========================================================= */

QFrame#valuableCardsCard {
    background-color: #181c25;
    border: 1px solid #2a3140;
    border-radius: 10px;
}

QFrame#valuableCardsCard:hover {
    background-color: #1f2430;
    border: 1px solid #3a445a;
}

QLabel#valuableCardsTitle {
    background: transparent;
    color: #E8E9EC;
    font-size: 15px;
    font-weight: 700;
}

QLabel#valuableCardsSubtitle {
    background: transparent;
    color: #8b93a3;
    font-size: 10px;
}

QLabel#valuableCardsEmpty {
    background: transparent;
    color: #666B74;
    font-size: 12px;
    padding: 12px 0;
}

QFrame#valuableCardRow {
    background-color: #12151b;
    border: 1px solid #232a37;
    border-radius: 7px;
}

QFrame#valuableCardRow:hover {
    background-color: #1c2029;
    border: 1px solid #3a4253;
}

QLabel#valuableCardRank {
    background-color: #2a2f3a;
    color: #e4c36b;
    border: 1px solid #3d4759;
    border-radius: 11px;
    font-size: 10px;
    font-weight: 800;
}

QFrame#valuableCardRow:hover QLabel#valuableCardRank {
    background-color: #3a3a26;
    border: 1px solid #d4a84b;
    color: #f0d589;
}

QLabel#valuableCardImage {
    background-color: #0c0f14;
    border: 1px solid #2b3240;
    border-radius: 4px;
    color: #666B74;
    font-size: 16px;
}

QFrame#valuableCardRow:hover QLabel#valuableCardImage {
    border: 1px solid #3d3a26;
}

QLabel#valuableCardName {
    background: transparent;
    color: #E7E9EC;
    font-size: 12px;
    font-weight: 600;
}

QLabel#valuableCardRarity {
    background: transparent;
    color: #8f9aac;
    font-size: 10px;
}

QLabel#valuableCardQuantity {
    background: transparent;
    color: #A9AEB7;
    font-size: 10px;
    font-weight: 600;
}

QLabel#valuableCardPrice {
    background: transparent;
    color: #E7E9EC;
    font-size: 11px;
    font-weight: 600;
}

QLabel#valuableCardTotal {
    background: transparent;
    color: #e4c36b;
    font-size: 12px;
    font-weight: 700;
}

QPushButton#valuableCardsViewAll {
    background-color: transparent;
    color: #d4a84b;
    border: 1px solid #3d3a26;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 10px;
    font-weight: 700;
}

QPushButton#valuableCardsViewAll:hover {
    background-color: #26291f;
    border: 1px solid #d4a84b;
    color: #f0d589;
}

QPushButton#valuableCardsViewAll:pressed {
    background-color: #2e311f;
}

/* =========================================================
   TOP 6 — ALTERNÂNCIA DE MODO (Individual / Coleção)
   ========================================================= */

QPushButton#valuableCardModeButton {
    background-color: #161a23;
    color: #9aa2b2;
    border: 1px solid #2f3646;
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 10px;
    font-weight: 600;
}

QPushButton#valuableCardModeButton:hover {
    color: #d9dde6;
    border: 1px solid #3d4759;
}

QPushButton#valuableCardModeButton:checked {
    background-color: #26291f;
    color: #e4c36b;
    border: 1px solid #d4a84b;
    font-weight: 700;
}

QPushButton#valuableCardModeButton:checked:hover {
    color: #f0d589;
    border: 1px solid #e4c36b;
}

/* =========================================================
   VALOR ESTIMADO — MOEDA + REFERÊNCIA SECUNDÁRIA
   ========================================================= */

QLabel#DashboardStatSecondary {
    background: transparent;
    color: #8b93a3;
    font-size: 11px;
}

QPushButton#currencySelectorButton {
    background-color: #161a23;
    color: #e4c36b;
    border: 1px solid #3d4759;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 10px;
    font-weight: 700;
}

QPushButton#currencySelectorButton:hover {
    background-color: #26291f;
    border: 1px solid #d4a84b;
    color: #f0d589;
}

QPushButton#currencySelectorButton:pressed {
    background-color: #2e311f;
}

QMenu#currencyMenu {
    background-color: #1a1e29;
    color: #e8ebf2;
    border: 1px solid #2f3646;
    border-radius: 8px;
    padding: 5px;
}

QMenu#currencyMenu::item {
    padding: 7px 26px 7px 12px;
    border-radius: 6px;
    color: #cfd4df;
}

QMenu#currencyMenu::item:selected {
    background-color: #292f3d;
    color: #ffffff;
}

QMenu#currencyMenu::item:checked {
    color: #e4c36b;
    font-weight: 700;
}

/* =========================================================
   BARRA DISCRETA — REFERÊNCIA DE PREÇOS (IMPRINT)
   ========================================================= */

QFrame#dashboardPricingBar {
    background-color: #141822;
    border: 1px solid #2a3140;
    border-radius: 9px;
}

QFrame#dashboardPricingBar:hover {
    border: 1px solid #3d4759;
}

QLabel#pricingBarTitle {
    background: transparent;
    color: #E8E9EC;
    font-size: 12px;
    font-weight: 700;
}

QLabel#pricingBarValue {
    background: transparent;
    color: #8b93a3;
    font-size: 11px;
}

QPushButton#pricingBarButton {
    background-color: transparent;
    color: #d4a84b;
    border: 1px solid #3d3a26;
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 10px;
    font-weight: 700;
}

QPushButton#pricingBarButton:hover {
    background-color: #26291f;
    border: 1px solid #d4a84b;
    color: #f0d589;
}

QPushButton#pricingBarButton:pressed {
    background-color: #2e311f;
}

/* =========================================================
   DONUT — LEGENDA
   ========================================================= */

QLabel#DashboardDonutLegendName {
    background: transparent;
    color: #d3d7de;
    font-size: 11px;
}

QLabel#DashboardDonutLegendValue {
    background: transparent;
    color: #E8E9EC;
    font-size: 11px;
    font-weight: 600;
}

QLabel#DashboardDonutLegendPercent {
    background: transparent;
    color: #8b93a3;
    font-size: 10px;
}