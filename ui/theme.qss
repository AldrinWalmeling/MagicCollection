    font-weight: 700;
}

QLabel#DeckTotalLabel {
    background-color: transparent;
    color: #8b93a3;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#DeckTab {
    background-color: transparent;
    color: #8b93a3;
